---
import UiText from "@components/UiText.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const links = [
	{ zh: "首页", en: "Home", href: "/" },
	{ zh: "笔记", en: "Notes", href: "/blog/notes/" },
	{ zh: "技术", en: "Technical", href: "/blog/technical/" },
	{ zh: "日常", en: "Daily Life", href: "/blog/daily-life/" },
	{ zh: "归档", en: "Archive", href: "/archive/" },
	{ zh: "分类", en: "Categories", href: "/categories/" },
	{ zh: "标签", en: "Tags", href: "/tags/" },
	{ zh: "项目", en: "Projects", href: "/projects/" },
	{ zh: "友链", en: "Links", href: "/friends/" },
	{ zh: "关于", en: "About", href: "/about/" },
	{ zh: "RSS", en: "RSS", href: "/rss/" },
	{ zh: "Atom", en: "Atom", href: "/atom/" },
];
---

<MainGridLayout title="网站地图" titleEn="Sitemap" hideSidebar>
	<main class="sitemap-page card-base onload-animation mx-auto w-full max-w-4xl rounded-[var(--radius-large)] p-6 md:p-8">
		<header>
			<Icon name="material-symbols:account-tree-outline-rounded" />
			<div>
				<h1><UiText zh="网站地图" en="Sitemap" /></h1>
				<p><UiText zh="快速访问博客中的主要页面。" en="Quickly access the main pages of the blog." /></p>
			</div>
		</header>

		<nav aria-label="网站地图">
			{links.map((link) => (
				<a href={url(link.href)}>
					<UiText zh={link.zh} en={link.en} />
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			))}
		</nav>
	</main>
</MainGridLayout>

<style>
	header {
		@apply mb-6 flex items-center gap-4 border-b border-black/10 pb-6 dark:border-white/10;
	}

	header > :global(svg) {
		@apply text-4xl text-[var(--primary)];
	}

	h1 {
		@apply text-3xl font-black text-black/90 dark:text-white/90;
	}

	p {
		@apply mt-1 text-sm text-black/50 dark:text-white/50;
	}

	nav {
		@apply grid grid-cols-1 gap-3 sm:grid-cols-2;
	}

	nav a {
		@apply flex min-h-14 items-center rounded-xl border border-black/10 bg-[var(--card-bg)] px-4 font-semibold text-black/70 transition hover:border-[var(--primary)] hover:text-[var(--primary)] dark:border-white/10 dark:text-white/70;
	}

	nav a > :global(svg) {
		@apply ml-auto text-xl transition-transform;
	}

	nav a:hover > :global(svg) {
		@apply translate-x-1;
	}
</style>
